{
  "name": "helius-mcp",
  "version": "2.1.0",
  "description": "Official Clawd/Helius MCP Server — Solana blockchain data access for Clawd agents (helius-mcp)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "helius-mcp": "dist/index.js"
  },
  "keywords": [
    "helius",
    "solana",
    "blockchain",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "claude",
    "web3",
    "nft",
    "defi",
    "websocket",
    "laserstream"
  ],
  "author": "Helius Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/helius-labs/core-ai"
  },
  "homepage": "https://github.com/helius-labs/core-ai#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.0.0",
    "bs58": "^6.0.0",
    "helius-sdk": "^3.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "auto-changelog": "^2.5.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "system-prompts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -p \"'export const version = \\'' + require('./package.json').version + '\\';'\" > src/version.ts",
    "build": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.js')) { console.error('dist/index.js missing'); process.exit(1);} console.log('dist ready', require('./package.json').version);\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "validate": "node dist/scripts/validate-catalog.js",
    "test": "node tests/smoke-launch.mjs",
    "changelog": "auto-changelog --tag-prefix helius-mcp@",
    "start:stdio": "node dist/index.js",
    "test:unit": "vitest run --passWithNoTests",
    "test:smoke": "node tests/smoke-launch.mjs"
  }
}
