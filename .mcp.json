{
  "mcpServers": {
    "DFlow": {
      "type": "http",
      "url": "https://api.paybox.sh/mcp?app=dflow"
    },
    "Helius": {
      "type": "http",
      "url": "https://api.helius.dev/mcp"
    },
    "Jupiter": {
      "type": "http",
      "url": "https://api.jup.ag/mcp"
    },
    "Birdeye": {
      "type": "http",
      "url": "https://public-api.birdeye.so/mcp"
    },
    "zkcompression": {
      "type": "http",
      "url": "https://www.zkcompression.com/mcp"
    },
    "clawd-mcp": {
      "command": "npx",
      "args": ["-y", "helius-mcp@latest"],
      "env": {
        "HELIUS_API_KEY": "${HELIUS_API_KEY}",
        "SOLANA_RPC_URL": "${SOLANA_RPC_URL}"
      }
    },
    "clawd-code-explorer": {
      "command": "node",
      "args": ["clawd-code/mcp-server/dist/index.js"],
      "env": {
        "CLAUDE_CODE_SRC_ROOT": "./clawd-code/src",
        "CLAWD_CODE_SRC_ROOT": "./clawd-code/src"
      }
    }
  }
}
