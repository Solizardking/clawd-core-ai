# Clawd Cloud — copy to .env.local (never commit secrets)

# LLM providers
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Solana / Helius
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Connectors (DFlow, Jupiter, Birdeye)
DFLOW_API_KEY=
JUPITER_API_KEY=
BIRDEYE_API_KEY=

# Optional remote MCP overrides
DFLOW_MCP_URL=https://api.paybox.sh/mcp?app=dflow
HELIUS_MCP_URL=https://api.helius.dev/mcp
JUPITER_MCP_URL=https://api.jup.ag/mcp
BIRDEYE_MCP_URL=https://public-api.birdeye.so/mcp
CLAWD_CONNECTORS_TIMEOUT_MS=15000

# Trading (paper by default)
LIVE_TRADING=false
OPERATOR_CONFIRMED=false
PERPS_SIM_ONLY=true
VULCAN_MCP_URL=
