/* 🦞 ClawdRouter — Web UI */
:root {
  --bg: #0b1220;
  --panel: #101a30;
  --panel2: #15223d;
  --border: #233354;
  --text: #e6edf7;
  --muted: #8aa1c4;
  --accent: #14f195;
  --accent2: #38bdf8;
  --danger: #f87171;
  --chip: #1b2944;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  min-height: 100vh;
}

.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 22px;
  background: var(--panel);
  border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 10;
}
.brand { font-size: 18px; }
.brand .sub { font-size: 12px; color: var(--muted); margin-left: 8px; }
.topbar-right { display: flex; align-items: center; gap: 12px; }

.state-pill {
  font-size: 12px; padding: 4px 12px;
  border-radius: 999px;
  background: var(--panel2); border: 1px solid var(--border);
  color: var(--muted);
}
.state-pill.connected { color: var(--accent); border-color: var(--accent); }

.layout {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 20px;
  padding: 22px;
  max-width: 1200px;
  margin: 0 auto;
}
@media (max-width: 820px) { .layout { grid-template-columns: 1fr; } }

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
}
.panel h2 { font-size: 15px; margin-bottom: 12px; letter-spacing: .3px; }

.wallet-line {
  display: flex; justify-content: space-between;
  padding: 6px 0; font-size: 13px;
  border-bottom: 1px dashed var(--border);
}
.wallet-line .label { color: var(--muted); }
.wallet-line code { font-size: 12px; color: var(--accent2); word-break: break-all; max-width: 60%; text-align: right; }

.row { display: flex; align-items: center; gap: 10px; margin: 12px 0; }
.token-picker, .amounts { flex-wrap: wrap; }

.btn {
  border: 1px solid var(--border);
  background: var(--panel2);
  color: var(--text);
  padding: 9px 16px;
  border-radius: 10px;
  font-size: 13px;
  cursor: pointer;
  transition: all .15s ease;
}
.btn:hover { transform: translateY(-1px); border-color: var(--accent); }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.btn-primary { background: var(--accent); color: #04321c; font-weight: 700; border: none; }
.btn-secondary { background: var(--accent2); color: #042338; font-weight: 700; border: none; }
.btn.block { width: 100%; margin-top: 10px; }

.chip {
  background: var(--chip);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 999px;
  padding: 6px 14px;
  font-size: 12px;
  cursor: pointer;
}
.chip.active { border-color: var(--accent); color: var(--accent); }

.plan {
  margin-top: 18px;
  padding: 14px;
  background: var(--panel2);
  border-radius: 12px;
}
.plan h3 { font-size: 14px; margin-bottom: 4px; }

.muted { color: var(--muted); font-size: 12px; }
.tiny { font-size: 11px; margin-top: 8px; line-height: 1.5; }

.statusbox {
  margin-top: 14px;
  padding: 10px;
  border-radius: 10px;
  background: #0d1626;
  border: 1px solid var(--border);
  font-size: 12px;
  min-height: 20px;
  white-space: pre-wrap;
  color: var(--muted);
}
.statusbox.ok { color: var(--accent); border-color: var(--accent); }
.statusbox.err { color: var(--danger); border-color: var(--danger); }

.chat {
  height: 340px;
  overflow-y: auto;
  background: #0d1626;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px;
  font-size: 13px;
  margin-top: 8px;
}
.msg { margin-bottom: 10px; line-height: 1.5; white-space: pre-wrap; }
.msg .role { display: inline-block; font-size: 11px; margin-right: 8px; padding: 2px 8px; border-radius: 999px; }
.msg.user .role { background: #14335a; color: var(--accent2); }
.msg.assistant .role { background: #13402a; color: var(--accent); }
.msg.error { color: var(--danger); }

.chat-input-row { display: flex; gap: 10px; margin-top: 10px; }
.chat-input-row textarea {
  flex: 1;
  background: #0d1626; color: var(--text);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 13px;
  resize: none;
  font-family: inherit;
}
select {
  background: var(--panel2); color: var(--text);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 13px;
}