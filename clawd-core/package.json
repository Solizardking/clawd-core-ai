{
  "name": "@onchainai/clawd-core",
  "version": "1.0.1",
  "description": "Clawd Core — Solana-native agent toolkit: typed tools, plugins, and wallet clients with reflect-metadata tool discovery",
  "sideEffects": false,
  "files": ["dist/**/*", "constitution/**/*", "README.md", "package.json"],
  "scripts": {
    "sync:constitution": "rm -rf constitution && cp -R ../constitution constitution",
    "prebuild": "npm run sync:constitution",
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "zod": "^3.0.0"
  },
  "homepage": "https://github.com/Solizardking/clawd-core-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solizardking/clawd-core-ai.git",
    "directory": "core-ai/clawd-core"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Solizardking/clawd-core-ai/issues"
  },
  "keywords": ["solana", "ai", "agents", "clawd", "tools", "wallet", "web3", "claude"]
}