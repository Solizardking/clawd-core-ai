{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "lib": ["ESNext"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "bun:bundle": ["clawd-code/src/types/bun-bundle.d.ts"],
      "@openclawd/clawd-connectors": ["clawd-connectors/src/index.ts"],
      "@onchainai/clawd-core": ["core-ai/clawd-core/src/index.ts"]
    }
  },
  "include": [
    "clawd-code/src/**/*.ts",
    "clawd-code/src/**/*.tsx",
    "clawd-connectors/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

