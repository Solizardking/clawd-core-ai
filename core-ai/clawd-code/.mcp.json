{
  "mcpServers": {
    "clawd-code-explorer": {
      "command": "node",
      "args": ["mcp-server/dist/index.js"],
      "env": {
        "CLAUDE_CODE_SRC_ROOT": "./src",
        "CLAWD_CODE_SRC_ROOT": "./src"
      }
    },
    "pump-mcp": {
      "command": "node",
      "args": ["pump-mcp/dist/index.js"],
      "env": {
        "SOLANA_RPC_URL": "${SOLANA_RPC_URL}",
        "HELIUS_API_KEY": "${HELIUS_API_KEY}"
      }
    }
  }
}
