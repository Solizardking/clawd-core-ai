{
  "name": "clawd-code",
  "version": "1.0.0",
  "description": "Curl-installable Solana-native AI coding CLI with wallet creation and paper-gated perps workflows",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "clawd-code": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "files": [
    "dist",
    "install.sh",
    "README.md",
    "LICENSE",
    ".env.example",
    "clawd.json"
  ],
  "keywords": [
    "solana",
    "ai-agent",
    "moonshot",
    "kimi",
    "clawd",
    "clawd-code",
    "lobster",
    "perpetuals",
    "trading",
    "x402",
    "phoenix",
    "vulcan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild": ["postinstall"]
  },
  "homepage": "https://github.com/Solizardking/clawd-core-ai/tree/main/core-ai/clawd-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solizardking/clawd-core-ai.git",
    "directory": "core-ai/clawd-code"
  },
  "bugs": {
    "url": "https://github.com/Solizardking/clawd-core-ai/issues"
  },
  "author": "Solizardking",
  "license": "MIT",
  "dependencies": {
    "@types/bun": "^1.3.14",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}