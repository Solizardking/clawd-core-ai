{
  "version": 2,
  "builds": [
    {
      "src": "clawd-code/mcp-server/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "clawd-code/src/**",
          "clawd-code/mcp-server/src/**",
          "clawd-code/mcp-server/dist/**",
          "README.md"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/health", "dest": "clawd-code/mcp-server/api/index.ts" },
    { "src": "/mcp", "dest": "clawd-code/mcp-server/api/index.ts" },
    { "src": "/sse", "dest": "clawd-code/mcp-server/api/index.ts" },
    { "src": "/messages", "dest": "clawd-code/mcp-server/api/index.ts" },
    { "src": "/api", "dest": "clawd-code/mcp-server/api/index.ts" },
    { "src": "/(.*)", "dest": "clawd-code/mcp-server/api/index.ts" }
  ]
}
