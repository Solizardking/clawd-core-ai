{
  "name": "@onchainai/clawd-mcp",
  "version": "1.3.0",
  "description": "Clawd-wrapped Helius MCP Server - complete Solana blockchain data access for Clawd agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "helius-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node -p \"'export const version = \\'' + require('./package.json').version + '\\';'\" > src/version.ts",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "validate": "node dist/scripts/validate-catalog.js",
    "test": "pnpm build && pnpm validate && vitest run",
    "changelog": "auto-changelog --tag-prefix helius-mcp@",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "helius",
    "solana",
    "blockchain",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "clawd",
    "web3",
    "nft",
    "defi",
    "websocket",
    "laserstream"
  ],
  "author": "Helius Labs",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://open-clawd.local/Solizardking/core-ai"
  },
  "homepage": "https://open-clawd.local/Solizardking/core-ai#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.0.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "helius-sdk": "^3.0.0",
    "playwright": "^1.48.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "auto-changelog": "^2.5.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "system-prompts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "bigint-buffer",
      "bufferutil",
      "utf-8-validate"
    ]
  }
}
