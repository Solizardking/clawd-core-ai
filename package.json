{
  "name": "@anthropic-ai/claude-code",
  "version": "0.0.0-leaked",
  "description": "Clawd Cloud monorepo — Clawd Code CLI, Clawd Connectors, and Clawd Core AI. Root manifest preserves the leaked Claude Code archive identity.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "clawd-code/src/entrypoints/cli.tsx",
  "bin": {
    "claude": "clawd-code/src/entrypoints/cli.tsx",
    "clawd": "clawd-code/src/cli.ts"
  },
  "workspaces": [
    "clawd-code",
    "clawd-connectors",
    "clawd-code/mcp-server",
    "core-ai/clawd-core",
    "core-ai/clawd-plugin"
  ],
  "scripts": {
    "build": "bun run --cwd clawd-code build",
    "build:watch": "bun run --cwd clawd-code build:watch",
    "build:prod": "bun run --cwd clawd-code build:prod",
    "build:web": "bun run --cwd clawd-code build:web",
    "build:web:watch": "bun run --cwd clawd-code build:web:watch",
    "build:web:prod": "bun run --cwd clawd-code build:web:prod",
    "typecheck": "bun run --cwd clawd-code typecheck",
    "lint": "bun run --cwd clawd-code lint",
    "lint:fix": "bun run --cwd clawd-code lint:fix",
    "format": "bun run --cwd clawd-code format",
    "check": "bun run --cwd clawd-code check",
    "stack:doctor": "bun scripts/stack-doctor.ts",
    "stack:connectors": "bun run --cwd clawd-connectors doctor",
    "connectors:build": "bun run --cwd clawd-connectors build",
    "connectors:test": "bun run --cwd clawd-connectors test",
    "core:skills": "bun run --cwd core-ai compile-skills",
    "plugin:doctor": "node core-ai/clawd-plugin/cli.js doctor"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@commander-js/extra-typings": "^13.1.0",
    "@composio/core": "^0.16.0",
    "@growthbook/growthbook": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/sdk-logs": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "auto-bind": "^5.0.1",
    "axios": "^1.7.0",
    "chalk": "^5.4.0",
    "chokidar": "^4.0.0",
    "cli-boxes": "^3.0.0",
    "code-excerpt": "^4.0.0",
    "diff": "^7.0.0",
    "execa": "^9.5.0",
    "figures": "^6.1.0",
    "fuse.js": "^7.0.0",
    "highlight.js": "^11.11.0",
    "ignore": "^6.0.0",
    "lodash-es": "^4.17.21",
    "marked": "^15.0.0",
    "node-pty": "^1.1.0",
    "p-map": "^7.0.0",
    "picomatch": "^4.0.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.0",
    "react": "^19.0.0",
    "react-reconciler": "^0.31.0",
    "semver": "^7.6.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.1.0",
    "supports-hyperlinks": "^3.1.0",
    "tree-kill": "^1.2.2",
    "type-fest": "^4.30.0",
    "undici": "^7.3.0",
    "usehooks-ts": "^3.1.0",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/diff": "^7.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^3.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/semver": "^7.5.8",
    "@types/stack-utils": "^2.0.3",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.1.0"
}
